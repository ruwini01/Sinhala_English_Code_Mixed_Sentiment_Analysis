# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/

# Secrets
.env

# Data artifacts kept LOCAL (regenerated by the pipeline; provenance in ml/DATA.md).
# Tracked exceptions: raw/README.md (names the raw file + sha256) and
# processed/splits/ (row-id lists — committed so splits are never redone).
ml/data/raw/*
!ml/data/raw/README.md
ml/data/interim/*
!ml/data/interim/.gitkeep
ml/data/processed/*
!ml/data/processed/splits/
!ml/data/processed/tokenized/
ml/data/processed/tokenized/*
!ml/data/processed/tokenized/.gitkeep
ml/data/embeddings/

# Run outputs that are NOT committed (checkpoints, logs).
# NOTE: ml/results/ (experiment json + tables + figures) IS committed.
logs/
checkpoints/
*.joblib
*.pt
*.bin
*.gz

# OS
.DS_Store
Thumbs.db
